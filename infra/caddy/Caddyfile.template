{
    auto_https disable_redirects

    servers {
        timeouts {
            read_body 30s
            read_header 30s
            idle 5m
        }
    }
}

https://{{PUBLIC_HOST}}:{{HTTPS_PORT}} {
    bind {{LISTEN_ADDRESS}}
    tls {{TLS_DIRECTIVE}}
    header Strict-Transport-Security "max-age=31536000"

    # Browser ingress is WebSocket-only. The publisher is a separate, private
    # Envoy listener and is never a Caddy upstream.
    @realtime path /realtime /realtime/* /api/broadcast /api/broadcast/*
    handle @realtime {
        @url_apikey query apikey=*
        handle @url_apikey {
            respond 400
        }
        @socket {
            method GET
            path /realtime/v1/websocket
            header_regexp Connection `(?i)(^|,\s*)upgrade(\s*,|$)`
            header_regexp Upgrade `(?i)^websocket$`
            # The optional root gateway can map a different host port. Production
            # and native renderers use the listener port unless that mapping is supplied.
            expression `{http.request.header.Origin} == "https://{{PUBLIC_HOST}}:{$OPENSLATE_REALTIME_PUBLIC_PORT:{{HTTPS_PORT}}}" || ({$OPENSLATE_REALTIME_PUBLIC_PORT:{{HTTPS_PORT}}} == 443 && {http.request.header.Origin} == "https://{{PUBLIC_HOST}}")`
        }
        handle @socket {
            reverse_proxy {$OPENSLATE_REALTIME_UPSTREAM:api-gw:8000} {
                header_up apikey {$SUPABASE_PUBLISHABLE_KEY}
                header_up -Authorization
                header_up -Cookie
                header_up -X-API-Key
                header_up -Forwarded
                header_up X-Forwarded-For {http.request.remote.host}
                header_up X-Forwarded-Host {http.request.hostport}
                header_up X-Forwarded-Proto {http.request.scheme}
                header_down -apikey
                header_down -X-API-Key
                header_down -Authorization
                header_down -Set-Cookie
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }
        handle {
            respond 404
        }
    }

    @events path /api/events
    handle @events {
        reverse_proxy {{UPSTREAM_HOST}}:{{BACKEND_PORT}} {
            # Do not buffer or compress server-sent events.  FastAPI must send
            # its initial response headers within response_header_timeout.
            flush_interval -1
            stream_timeout 24h
            header_up -Accept-Encoding
            header_up Host {http.request.hostport}
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Host {http.request.hostport}
            header_up X-Forwarded-Proto {http.request.scheme}
            transport http {
                compression off
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }

    @backup_export_content {
        method GET
        path_regexp backup_export_content "^/api/backups/exports/[^/]+/content$"
    }
    handle @backup_export_content {
        reverse_proxy {{UPSTREAM_HOST}}:{{BACKEND_PORT}} {
            flush_interval -1
            header_up -Accept-Encoding
            header_up Host {http.request.hostport}
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Host {http.request.hostport}
            header_up X-Forwarded-Proto {http.request.scheme}
            transport http {
                compression off
                dial_timeout 5s
                response_header_timeout 330s
            }
        }
    }

    @api path /api /api/*
    handle @api {
        reverse_proxy {{UPSTREAM_HOST}}:{{BACKEND_PORT}} {
            header_up Host {http.request.hostport}
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Host {http.request.hostport}
            header_up X-Forwarded-Proto {http.request.scheme}
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
            }
        }
    }

    handle {
        reverse_proxy {{UPSTREAM_HOST}}:{{BACKEND_PORT}} {
            header_up Host {http.request.hostport}
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Host {http.request.hostport}
            header_up X-Forwarded-Proto {http.request.scheme}
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
            }
        }
    }
}

# This loopback listener is used only by Compose health checks. It leaves public
# TLS and virtual hosts untouched in both bridged and native-Linux host modes.
http://127.0.0.1:{{HEALTH_PORT}} {
    bind 127.0.0.1

    @health path /api/health
    handle @health {
        reverse_proxy {{UPSTREAM_HOST}}:{{BACKEND_PORT}}
    }

    respond 404
}
