# Frontend-only environment. Do not source the repository root .env into npm
# or Next.js; it also contains backend and database-owner credentials.
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# NEXT_PUBLIC_LIFECYCLE_PURGE_ENABLED=false
