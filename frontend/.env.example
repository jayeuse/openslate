# Reference for the GENERATED frontend/.env.local boundary.
# Edit the repository root .env. Local npm dev/build/start commands regenerate
# the real frontend file through scripts/environment.py before starting Next.
# CI/container tests instead pass these exact process variables explicitly.
# Never add admin, database-owner, database-password or service-role credentials.
BACKEND_URL=
SUPABASE_SERVER_URL=
LOG_DIR=
PORT=
HOSTNAME=
BFF_REQUEST_BODY_LIMIT_BYTES=
BFF_RESPONSE_BODY_LIMIT_BYTES=
BFF_REQUEST_DEADLINE_MS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_LIFECYCLE_PURGE_ENABLED=
