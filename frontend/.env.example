# Frontend-only environment. Do not source the repository root .env into npm
# or Next.js; it also contains backend and database-owner credentials.
BACKEND_URL=http://localhost:8000
# Optional server-only log directory; defaults to frontend/logs for npm commands.
# Use an absolute writable mounted path for persistent container logs (UTC dates).
# LOG_DIR=/absolute/path/to/frontend/logs
# Server-only BFF reliability bounds. Keep these private; do not use
# NEXT_PUBLIC_ names or change them from product UI.
BFF_REQUEST_BODY_LIMIT_BYTES=1048576
BFF_RESPONSE_BODY_LIMIT_BYTES=8388608
BFF_REQUEST_DEADLINE_MS=60000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_LIFECYCLE_PURGE_ENABLED=false
