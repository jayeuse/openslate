{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/start-standalone.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "verify": "npm run check && npm run build && npm run test:e2e:production",
    "test:e2e": "TEST_LAYER=all BASE_URL=http://127.0.0.1:3104 PLAYWRIGHT_CONFIGURATION=synthetic node scripts/run-playwright.mjs",
    "test:e2e:fullstack": "cd ../backend && uv run python -m tests.fullstack_runner",
    "test:e2e:production": "PLAYWRIGHT_USE_PRODUCTION=1 TEST_LAYER=all BASE_URL=http://127.0.0.1:3104 PLAYWRIGHT_CONFIGURATION=synthetic node scripts/run-playwright.mjs",
    "test:section": "python3 ../scripts/test.py frontend section",
    "test:affected": "python3 ../scripts/test.py frontend affected",
    "test:full": "python3 ../scripts/test.py frontend full",
    "test:scanner:coverage": "SCANNER_COVERAGE=1 TEST_LAYER=browser BASE_URL=http://127.0.0.1:3104 PLAYWRIGHT_CONFIGURATION=synthetic node scripts/run-playwright.mjs --project=chromium tests/browser/files/library.spec.ts && node scripts/scanner-coverage.mjs",
    "test:coverage": "node scripts/run-coverage.mjs"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "@base-ui/react": "^1.8.0",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.115.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.42.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "istanbul-lib-coverage": "^3.2.2",
    "monocart-coverage-reports": "^2.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "v8-to-istanbul": "^9.3.0"
  }
}
