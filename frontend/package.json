{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tooling/run-next.mjs dev",
    "build": "node tooling/run-next.mjs build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:contrast",
    "check:contrast": "node tooling/check-theme-contrast.mjs",
    "test": "TEST_LAYER=all BASE_URL=http://127.0.0.1:3104 PLAYWRIGHT_CONFIGURATION=synthetic node tooling/run-playwright.mjs",
    "verify": "npm run check && npm run build && npm test",
    "test:section": "python3 ../scripts/run_tests.py frontend section",
    "test:affected": "python3 ../scripts/run_tests.py frontend affected",
    "test:full": "python3 ../scripts/run_tests.py frontend full"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
