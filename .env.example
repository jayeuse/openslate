# OpenSlate's single editable environment file. Copy to .env and keep it private.
# Filled .env files must never be committed or sourced into npm/Next.js.
# ${NAME} references another key in THIS file; missing references are errors.
# Runtime code has no localhost, numeric, credential or legacy-name fallbacks.

# Stack identity and ports. Change a port here, not in source or startup commands.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_DATABASE=openslate
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
# Development-only Next hot-reload listener. Production has no Node runtime.
FRONTEND_DEV_PORT=3000
FILES_CLAMAV_PORT=3310
PGWEB_BIND_HOST=127.0.0.1
PGWEB_PORT=8081
# Used only by the opt-in `gateway` Compose profile for production-level testing.
GATEWAY_PUBLIC_HOST=localhost
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=3448

# Public identities and host transports. URL references keep ports in one place.
BACKEND_URL=http://localhost:${BACKEND_PORT}
# Daily development defaults to localhost. With a loopback backend, a local,
# private, or link-local browser address on FRONTEND_DEV_PORT is also supported.
PUBLIC_ORIGIN=http://localhost:${FRONTEND_DEV_PORT}

# PostgreSQL and application secrets. Keep filled values private.
# The disposable loopback development database starts with this known password.
# Change it before using the database beyond local development.
POSTGRES_BOOTSTRAP_PASSWORD=openslate-local-development
# DATABASE_BOOTSTRAP_URL is a short-lived cluster-admin connection for provisioning only.
# MIGRATION_DATABASE_URL is openslate_owner; DATABASE_URL is openslate_runtime.
# DATABASE_INSPECTOR_URL is the read-only openslate_inspector login used only by pgweb.
DATABASE_BOOTSTRAP_URL=
MIGRATION_DATABASE_URL=
DATABASE_URL=
DATABASE_INSPECTOR_URL=
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=${PUBLIC_ORIGIN}
AUTH_JWT_AUDIENCE=openslate-api
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
SECURITY_EVENT_SERVER_KEY=

# Optional SMTP delivery. Keep SMTP_ENABLED=false to run without mail delivery.
# When enabled, the installer generates SMTP_DELIVERY_ENCRYPTION_KEY as a Fernet key.
# SMTP_TRANSPORT is starttls, implicit_tls, or plain (plain is loopback development only).
SMTP_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TRANSPORT=starttls
# SMTP_DELIVERY_ENCRYPTION_KEY=
# SMTP_TIMEOUT_SECONDS=10
# SMTP_DELIVERY_OPERATION_TIMEOUT_SECONDS=30
# SMTP_DELIVERY_BATCH_SIZE=10
# SMTP_DELIVERY_MAX_ATTEMPTS=5

# Existing administrator / local manual-test sign-in. Never sent to the frontend.
# Bootstrap reads email/username and still uses an invitation; storing a password
# here does not create an account, accept an invitation or reset its password.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Short-lived local administrator bearer token used only by the optional sample seeder.
SEED_ACCESS_TOKEN=

# API configuration. Values are explicit, including booleans and safety limits.
ENVIRONMENT=development
LIFECYCLE_PURGE_ENABLED=false
FILES_STORAGE_ROOT=/absolute/path/to/openslate/private-files
LOG_DIR=/tmp/openslate/backend/logs
SERVER_MAX_CONCURRENCY=32
SERVER_KEEP_ALIVE_SECONDS=5
REQUEST_BODY_MAX_BYTES=1048576
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=15000
READINESS_POOL_TIMEOUT_SECONDS=0.25
READINESS_CONNECT_TIMEOUT_SECONDS=1
READINESS_STATEMENT_TIMEOUT_MS=500
READINESS_CALLER_TIMEOUT_SECONDS=2

# Local Docker resource configuration.
CLAMAV_MEMORY_LIMIT=4g
CLAMAV_CPUS=2
CLAMAV_PIDS_LIMIT=64

# Scanner worker / engine. Provision a verified immutable generation first.
# The API does not need these files; starting the scanner requires all of them.
# These example paths are intentional placeholders, never auto-created definitions.
FILES_CLAMAV_HOST=clamav
SCANNER_DEFINITIONS=/absolute/path/to/verified/clamav/definitions
FILES_CLAMAV_MANIFEST_PATH=/absolute/path/to/verified/clamav/manifest.json
