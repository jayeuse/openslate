# Local OpenSlate environment. Copy to .env; never commit the filled file.
#
# Supabase CLI values are intentionally placeholders here. Run
# `supabase status -o env` after `supabase start` and map only the values
# documented in README.md. Do not paste the complete status output into git.

# DB_URL from `supabase status -o env`, using the psycopg SQLAlchemy scheme.
# Alembic uses the owner connection; FastAPI uses the separately provisioned
# least-privilege login. URL-encode generated passwords in connection URLs.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-with-local-db-password@127.0.0.1:54322/postgres
OPENSLATE_DATABASE_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=postgresql+psycopg://openslate_runtime:replace-with-url-encoded-runtime-password@127.0.0.1:54322/postgres

# API_URL, ANON_KEY, and SERVICE_ROLE_KEY from `supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
# Server-only: SERVICE_ROLE_KEY from `supabase status -o env`.
SUPABASE_SECRET_KEY=replace-with-local-service-role-key
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Derived from API_URL; do not use the service-role key in browser code.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Backend host configuration.
CORS_ORIGINS='["http://localhost:3000"]'
# Optional server-only log directory; defaults to backend/logs. Use an absolute
# writable mounted path for persistent container logs. Files use UTC dates.
# LOG_DIR=/absolute/path/to/backend/logs

# Runtime safety limits. Keep these server-only; do not copy them into the frontend.
REQUEST_BODY_MAX_BYTES=1048576
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=15000
READINESS_POOL_TIMEOUT_SECONDS=0.25
READINESS_CONNECT_TIMEOUT_SECONDS=1
READINESS_STATEMENT_TIMEOUT_MS=500
READINESS_CALLER_TIMEOUT_SECONDS=2
SUPABASE_TIMEOUT_SECONDS=10

# The frontend uses its separate frontend/.env.local file. Do not copy backend
# secrets or the root environment into the frontend process.
