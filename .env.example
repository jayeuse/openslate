# OpenSlate's single editable environment file. Copy to .env and keep it private.
# Filled .env files must never be committed or sourced into npm/Next.js.
# ${NAME} references another key in THIS file; missing references are errors.
# Runtime code has no localhost, numeric, credential or legacy-name fallbacks.

# Stack identity and ports. Use a unique identity and private root for every worktree.
OPENSLATE_INSTANCE_ID=openslate
OPENSLATE_INSTANCE_ROOT=/absolute/path/to/openslate-instance
POSTGRES_HOST=127.0.0.1
SUPABASE_DB_PORT=55432
SUPABASE_API_PORT=58000
# Optional development-only publisher: loopback 127.0.0.1, server-key authenticated.
# Omit to use Compose's 58001 default. The production listener is not published.
SUPABASE_REALTIME_PUBLISH_PORT=58001
SUPABASE_MAIL_PORT=58025
POSTGRES_PORT=${SUPABASE_DB_PORT}
POSTGRES_DATABASE=postgres
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
# Production Caddy/API private network and trusted proxy CIDR. Override on collision.
OPENSLATE_APP_PRIVATE_SUBNET=172.31.248.0/28
# Development-only Next hot-reload listener. Production has no Node runtime.
FRONTEND_DEV_PORT=3000
# Used only by the opt-in `gateway` Compose profile for production-level testing.
GATEWAY_PUBLIC_HOST=localhost
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=3448

# Public identities and host transports. URL references keep ports in one place.
BACKEND_URL=http://localhost:${BACKEND_PORT}
# Daily development defaults to localhost. With a loopback backend, a local,
# private, or link-local browser address on FRONTEND_DEV_PORT is also supported.
PUBLIC_ORIGIN=http://localhost:${FRONTEND_DEV_PORT}

# Generate per-installation credentials with backend/operations/supabase_keys.py
# into an owner-only environment file. Do not commit or print their values.
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_KEYS=
JWT_JWKS=
ANON_KEY=
SERVICE_ROLE_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SESSION_ENCRYPTION_KEY=
PG_META_CRYPTO_KEY=
# Realtime's own session base and its 16-character tenant-secret encryption key.
REALTIME_SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=
# Host-run API uses the loopback gateway; Auth signs with the public issuer.
SUPABASE_URL=http://127.0.0.1:${SUPABASE_API_PORT}
SUPABASE_PUBLIC_URL=http://127.0.0.1:${SUPABASE_API_PORT}
SUPABASE_AUTH_ISSUER=http://127.0.0.1:${SUPABASE_API_PORT}/auth/v1
API_EXTERNAL_URL=${SUPABASE_AUTH_ISSUER}
SITE_URL=${PUBLIC_ORIGIN}
# Shared internal base for invite, recovery, and secure two-address email-change templates.
# Secure email change is fixed on in Compose; production uses http://api:8000 here.
AUTH_TEMPLATE_BASE_URL=http://host.docker.internal:${BACKEND_PORT}/api/auth/email-templates
SUPABASE_TIMEOUT_SECONDS=10
SMTP_ADMIN_EMAIL=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=OpenSlate
# The development overlay publishes Mailpit's UI on SUPABASE_MAIL_PORT.
# Provider data and file bytes occupy dedicated, project-prefixed Docker volumes.
# SQLAlchemy and Alembic retain their own least-privilege direct connections.
# DATABASE_BOOTSTRAP_URL uses supabase_admin with POSTGRES_PASSWORD for provisioning only.
# MIGRATION_DATABASE_URL is openslate_owner; DATABASE_URL is openslate_runtime.
DATABASE_BOOTSTRAP_URL=
MIGRATION_DATABASE_URL=
DATABASE_URL=
# Backend-only key for short-lived Sandbox publication capabilities, not user authentication.
PUBLICATION_SIGNING_KEY=
# Backend-only ES256 private JWK that signs 5-minute Realtime channel tokens. Its public
# key is part of JWT_JWKS; generate both with operations/supabase_keys.py.
REALTIME_TOKEN_SIGNING_KEY=
AUTH_REFRESH_TOKEN_DAYS=7
SECURITY_EVENT_SERVER_KEY=

# First administrator email invitation. Complete the emailed link to set a password.
# Username is a profile label; authentication uses the email address.
ADMIN_EMAIL=
ADMIN_USERNAME=

# Short-lived local administrator bearer token used only by the optional sample seeder.
SEED_ACCESS_TOKEN=

# API configuration. Values are explicit, including booleans and safety limits.
ENVIRONMENT=development
LIFECYCLE_PURGE_ENABLED=true
LOG_DIR=${OPENSLATE_INSTANCE_ROOT}/backend/logs
# Production finished exports: precreate the exact backup-config repository sibling
# named backup-exports, owned by the operator with group 10001 and mode 0750.
OPENSLATE_BACKUP_EXPORT_ROOT=/absolute/path/to/backup-exports
# Optional host-run API override; production Compose fixes the container path.
# BACKUP_EXPORT_ROOT=/var/lib/openslate/backup-exports
# Leave room for the static frontend's parallel asset requests while retaining admission limits.
SERVER_MAX_CONCURRENCY=64
SERVER_KEEP_ALIVE_SECONDS=5
REQUEST_BODY_MAX_BYTES=1048576
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=15000
READINESS_POOL_TIMEOUT_SECONDS=0.25
READINESS_CONNECT_TIMEOUT_SECONDS=1
READINESS_STATEMENT_TIMEOUT_MS=500
READINESS_CALLER_TIMEOUT_SECONDS=2
